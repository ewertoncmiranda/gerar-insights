{
  "type": "object",
  "required": [
    "schemaVersion",
    "dedupKey",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "dedupKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "data"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "required": [
              "historicalDataPrice"
            ],
            "properties": {
              "usedInterval": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "historicalDataPrice": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "date",
                    "close"
                  ],
                  "properties": {
                    "date": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "close": {
                      "type": "number"
                    },
                    "open": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "high": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "low": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "volume": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
