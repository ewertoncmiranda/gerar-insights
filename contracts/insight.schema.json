{
  "type": "object",
  "required": ["schemaVersion", "versao_payload", "resumo"],
  "properties": {
    "schemaVersion": {"enum": ["2.1", "3.0"]},
    "versao_payload": {"enum": ["2.1", "3.0"]},
    "aviso_legal": {"type": "string", "minLength": 1},
    "resumo": {
      "type": "object",
      "required": [
        "recomendacao"
      ],
      "properties": {
        "recomendacao": {
          "enum": [
            "COMPRA_FORTE",
            "COMPRA_MODERADA",
            "VENDA_VALUATION",
            "ALERTA_RISCO",
            "MANTER",
            "SEM_DADOS",
            "SINAL_POSITIVO_FORTE",
            "SINAL_POSITIVO",
            "SEM_MARGEM",
            "NEUTRO"
          ]
        },
        "sinal_quantitativo": {
          "enum": ["SINAL_POSITIVO_FORTE", "SINAL_POSITIVO", "SEM_MARGEM", "ALERTA_RISCO", "NEUTRO", "SEM_DADOS"]
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": "2.1"}}},
      "then": {"properties": {"versao_payload": {"const": "2.1"}}}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": "3.0"}}},
      "then": {
        "required": ["aviso_legal"],
        "properties": {
          "versao_payload": {"const": "3.0"},
          "resumo": {"required": ["sinal_quantitativo", "recomendacao"]}
        }
      }
    }
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
