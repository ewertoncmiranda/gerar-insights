# Example docker env for gerar-insights (placed in gerar-insights/env/.env.docker)
ENVIRONMENT=docker
LOCALSTACK_ENDPOINT=http://localstack:4566
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
QUEUE_NAME=tratar-ativos

DB_DRIVER=mysql+pymysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=spring
DB_PASS=spring123
DB_NAME=minha_base

RETRY_ATTEMPTS=3
RETRY_DELAY=10
LOG_LEVEL=INFO
